OPENAI_API_KEY=sk-...

# GitHub OAuth App (create one at https://github.com/settings/developers
# with Authorization callback URL = http://localhost:8787/auth/github/callback)
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any long random string — signs session JWTs. Regenerating logs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string
